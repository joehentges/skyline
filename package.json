{
  "name": "skyline",
  "description": "A Next.js monolithic boilerplate. Quickly get started on your next project.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "format": "ultracite check --write ./src",
    "lint": "ultracite fix ./src",
    "pre": "npm run format && npm run lint && npm run build",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:migrate": "tsx ./src/db/migrate.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:clear": "tsx ./src/db/clear.ts",
    "db:seed": "tsx ./src/db/seed.ts",
    "db:reset": "npm run db:clear && npm run db:migrate"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@marsidev/react-turnstile": "1.5.2",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@t3-oss/env-nextjs": "0.13.11",
    "argon2": "0.44.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "next-safe-action": "8.5.2",
    "next-themes": "0.4.6",
    "pg": "8.21.0",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-email": "6.1.5",
    "react-hook-form": "7.76.0",
    "resend": "6.12.3",
    "sonner": "2.0.7",
    "stripe": "22.1.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "ultracite": "7.7.0"
  }
}
